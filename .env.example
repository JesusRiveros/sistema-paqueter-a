# Copia este archivo como .env y completa los valores.

# Clave para firmar las sesiones de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave

# API key de Google Maps (Places, Directions, Distance Matrix y Geocoding).
# Restringela por dominio y por API en Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# URL publica del sitio (sin / al final). Se usa en el QR de la guia, en los enlaces de los
# correos, en el regreso de Stripe y para validar la firma de Twilio (debe ser EXACTA).
PUBLIC_BASE_URL=https://balulaexpress.com

# 1 = la app esta detras de Cloudflare Tunnel y confia en las cabeceras X-Forwarded-* (HTTPS real)
TRUST_PROXY=1

# 1 = muestra la pasarela de pago simulada (demo). 0 = la oculta.
PAGOS_SIMULADOS=1

# 1 = modo desarrollo de Flask (recarga automatica y errores detallados). En la demo publica: 0.
FLASK_DEBUG=0

# --- Asistente de atención al cliente (Claude) ---
# Crea la key en https://console.anthropic.com -> API Keys. Nunca la subas a git.
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-haiku-5-5
ASISTENTE_ESFUERZO=low
# Cuántos turnos previos se reenvían al modelo (más = más contexto y más costo)
ASISTENTE_MAX_TURNOS_HISTORIAL=10
# Equipo humano para escalamientos (si se dejan vacíos se usan los del sitio)
ASISTENTE_TELEFONO_HUMANO=
ASISTENTE_HORARIO_HUMANO=
# Precio por millón de tokens (USD) para estimar costos
ASISTENTE_PRECIO_ENTRADA_MTOK=0.10
ASISTENTE_PRECIO_SALIDA_MTOK=0.50

# --- Base de datos ---
# Vacío = SQLite en sistema paqueteria/instance/balula.sqlite3
# Producción (PostgreSQL): DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/balula
DATABASE_URL=
# 1 = cookies de sesión solo por HTTPS. Con el sitio publicado en https://balulaexpress.com ponlo en 1.
# (Si pruebas en http://127.0.0.1 con este valor en 1, no podrás iniciar sesión: usa 0 en local.)
SESSION_COOKIE_SECURE=1

# --- Avisos por correo (opcional; sin SMTP_HOST solo se registran) ---
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=Balula Express <no-responder@tu-dominio.com>

# --- Llamadas telefónicas (Twilio) ---
# En la consola de Twilio, apunta el número a {PUBLIC_BASE_URL}/voz/twilio/entrante (HTTP POST).
TWILIO_AUTH_TOKEN=
# Número (formato +52...) al que se transfiere cuando hay que pasar con una persona
TWILIO_NUMERO_HUMANO=
TWILIO_VOZ=Polly.Mia-Neural

# --- Pagos con Stripe (SOLO llaves de prueba) ---
# Dashboard de Stripe → Desarrolladores → Claves de API (con "Modo de prueba" activado).
# Si pones una llave sk_live_/pk_live_ el servidor se niega a arrancar.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secreto de firma del webhook (whsec_...): Desarrolladores → Webhooks → tu endpoint → "Secreto de firma"
STRIPE_WEBHOOK_SECRET=
